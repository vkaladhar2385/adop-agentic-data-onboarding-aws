{# template_id: eventbridge_schedule #}
{
  "Comment": "EventBridge Scheduler for {{ workload }} ({{ cadence | default('scheduled') }}).",
  "Name": "{{ schedule_name }}",
  "ScheduleExpression": "{{ cron }}",
  "ScheduleExpressionTimezone": "{{ timezone | default('UTC') }}",
  "FlexibleTimeWindow": { "Mode": "{{ flexible_time_window | default('OFF') }}" },
  "Target": {
    "Arn": "arn:aws:states:us-east-1:<account>:stateMachine:{{ state_machine }}",
    "RoleArn": "arn:aws:iam::<account>:role/{{ scheduler_role }}",
    "Input": {
      "source_path": "s3://data-lake-<account>-us-east-1/landing/{{ workload }}/",
      "bronze_path": "s3://data-lake-<account>-us-east-1/bronze/{{ workload }}/",
      "silver_path": "s3://data-lake-<account>-us-east-1/silver/{{ workload }}/",
      "gold_path": "s3://data-lake-<account>-us-east-1/gold/{{ workload }}/"
    },
    "RetryPolicy": {
      "MaximumRetryAttempts": {{ retries | default(2) }},
      "MaximumEventAgeInSeconds": {{ max_event_age_seconds | default(3600) }}
    }
  }
}
