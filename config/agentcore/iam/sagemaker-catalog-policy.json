{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueCatalogMetadata",
      "Effect": "Allow",
      "Action": ["glue:GetTable", "glue:UpdateTable"],
      "Resource": [
        "arn:aws:glue:*:*:catalog",
        "arn:aws:glue:*:*:database/*",
        "arn:aws:glue:*:*:table/*/*"
      ]
    }
  ]
}
