{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3List",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "KmsList",
      "Effect": "Allow",
      "Action": ["kms:ListKeys", "kms:DescribeKey"],
      "Resource": "*"
    },
    {
      "Sid": "SecretsDescribe",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret"],
      "Resource": "*"
    }
  ]
}
