{
  "Comment": "ADOP advisory_transactions pipeline. Bronze -> Silver -> Silver quality gate -> Gold -> Gold quality gate -> Catalog/LF-Tags -> Verify. Generated by Orchestration Agent (Phase 4d), engine=step_functions.",
  "StartAt": "IngestToBronze",
  "TimeoutSeconds": 3600,
  "States": {
    "IngestToBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "advisory_transactions_ingest_to_bronze",
        "Arguments": {
          "--source_path.$": "$.source_path",
          "--bronze_path.$": "$.bronze_path",
          "--enable-data-lineage": "true"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "BronzeToSilver"
    },

    "BronzeToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "advisory_transactions_bronze_to_silver",
        "Arguments": {
          "--bronze_path.$": "$.bronze_path",
          "--silver_path.$": "$.silver_path",
          "--enable-data-lineage": "true"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "SilverQualityGate"
    },

    "SilverQualityGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "advisory_transactions_quality_silver",
        "Arguments": { "--zone": "silver" }
      },
      "ResultPath": null,
      "Comment": "Fails the state machine if Silver score < 0.80 or any critical rule fails.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "QualityGateFailed" }],
      "Next": "SilverToGold"
    },

    "SilverToGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "advisory_transactions_silver_to_gold",
        "Arguments": {
          "--silver_path.$": "$.silver_path",
          "--gold_path.$": "$.gold_path",
          "--enable-data-lineage": "true"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "GoldQualityGate"
    },

    "GoldQualityGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "advisory_transactions_quality_gold",
        "Arguments": { "--zone": "gold" }
      },
      "ResultPath": null,
      "Comment": "Fails the state machine if Gold score < 0.95 or any critical rule fails.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "QualityGateFailed" }],
      "Next": "RegisterCatalog"
    },

    "RegisterCatalog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "advisory_transactions_register_catalog",
        "Payload": { "action": "register_and_tag" }
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "RegisterRedshiftSpectrum"
    },

    "RegisterRedshiftSpectrum": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "advisory_transactions_register_redshift_spectrum",
        "Payload": { "action": "register" }
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "IndexGoldToOpenSearch"
    },

    "IndexGoldToOpenSearch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "advisory_transactions_index_gold_to_opensearch",
        "Payload": { "action": "index" }
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "CacheQualityScores"
    },

    "CacheQualityScores": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "advisory_transactions_cache_quality_scores",
        "Payload": { "action": "cache", "zones": ["silver", "gold"] }
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "PostDeploymentVerify"
    },

    "PostDeploymentVerify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "advisory_transactions_post_deploy_verifier",
        "Payload": {
          "workload": "${workload}",
          "database": "${workload}_db",
          "state_machine": "${workload}_pipeline",
          "table": "silver_advisory_transactions",
          "pii_columns": ["client_ssn", "client_email"],
          "checks": [
            "tables_exist", "athena_returns_data", "lf_tags_applied", "kms_rotation", "audit_logged",
            "redshift_spectrum_returns_data", "opensearch_index_has_docs", "redis_quality_score_cached"
          ]
        }
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "Succeed"
    },

    "QualityGateFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:${aws_region}:${account_id}:${workload}-alerts",
        "Subject": "advisory_transactions: QUALITY GATE BLOCKED",
        "Message": "A quality gate failed (score below threshold or critical rule failed). Promotion stopped. Review quarantine table."
      },
      "Next": "Fail"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:${aws_region}:${account_id}:${workload}-alerts",
        "Subject": "advisory_transactions: PIPELINE FAILURE",
        "Message.$": "States.Format('Pipeline failed. Error: {}', $.Error)"
      },
      "Next": "Fail"
    },

    "Succeed": { "Type": "Succeed" },
    "Fail": { "Type": "Fail", "Error": "PipelineFailed", "Cause": "See SNS alert and CloudWatch logs." }
  }
}
