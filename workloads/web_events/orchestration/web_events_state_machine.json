{
  "Comment": "ADOP web_events GDPR micro-batch. Bronze -> Silver (consent filter + mask) -> Silver quality gate -> Gold -> Gold quality gate -> Catalog/LF-Tags -> Verify. Generated by Orchestration Agent (Phase 4d), engine=step_functions. Hourly EventBridge trigger.",
  "StartAt": "IngestToBronze",
  "TimeoutSeconds": 1800,
  "States": {
    "IngestToBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "web_events_ingest_to_bronze",
        "Arguments": {
          "--source_path.$": "$.source_path",
          "--bronze_path.$": "$.bronze_path",
          "--enable-data-lineage": "true"
        }
      },
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "BronzeToSilver"
    },

    "BronzeToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "web_events_bronze_to_silver",
        "Arguments": {
          "--bronze_path.$": "$.bronze_path",
          "--silver_path.$": "$.silver_path",
          "--enable-data-lineage": "true"
        }
      },
      "Comment": "Consent filter (GDPR): consent_analytics=false rows are suppressed here and never written to Silver/Gold.",
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "SilverQualityGate"
    },

    "SilverQualityGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "web_events_quality_silver",
        "Arguments": { "--zone": "silver" }
      },
      "Comment": "Fails the state machine if Silver score < 0.80 or any critical rule fails.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "QualityGateFailed" }],
      "Next": "SilverToGold"
    },

    "SilverToGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "web_events_silver_to_gold",
        "Arguments": {
          "--silver_path.$": "$.silver_path",
          "--gold_path.$": "$.gold_path",
          "--enable-data-lineage": "true"
        }
      },
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "GoldQualityGate"
    },

    "GoldQualityGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "web_events_quality_gold",
        "Arguments": { "--zone": "gold" }
      },
      "Comment": "Fails the state machine if Gold score < 0.95 or any critical rule fails.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "QualityGateFailed" }],
      "Next": "RegisterCatalog"
    },

    "RegisterCatalog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "web_events_register_catalog",
        "Payload": { "action": "register_and_tag" }
      },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "PostDeploymentVerify"
    },

    "PostDeploymentVerify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "web_events_post_deploy_verifier",
        "Payload": { "checks": ["tables_exist", "athena_returns_data", "lf_tags_applied", "kms_rotation", "audit_logged"] }
      },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "NotifyFailure" }],
      "Next": "Succeed"
    },

    "QualityGateFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:${aws_region}:${account_id}:${workload}-alerts",
        "Subject": "web_events: QUALITY GATE BLOCKED",
        "Message": "A quality gate failed (score below threshold or critical rule failed). Promotion stopped. Review quarantine table."
      },
      "Next": "Fail"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:${aws_region}:${account_id}:${workload}-alerts",
        "Subject": "web_events: PIPELINE FAILURE",
        "Message.$": "States.Format('Pipeline failed. Error: {}', $.Error)"
      },
      "Next": "Fail"
    },

    "Succeed": { "Type": "Succeed" },
    "Fail": { "Type": "Fail", "Error": "PipelineFailed", "Cause": "See SNS alert and CloudWatch logs." }
  }
}
