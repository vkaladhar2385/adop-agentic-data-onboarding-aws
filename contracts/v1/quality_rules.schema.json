{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/v1/quality_rules.schema.json",
  "title": "Workload quality rules (HITL)",
  "type": "object",
  "required": ["workload", "gates", "rules"],
  "additionalProperties": true,
  "properties": {
    "workload": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
    "gates": {
      "type": "object",
      "required": ["silver", "gold"],
      "properties": {
        "silver": { "type": "number", "minimum": 0, "maximum": 1 },
        "gold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "dimension": { "type": "string" },
          "critical": { "type": "boolean" },
          "threshold": { "type": "number" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
