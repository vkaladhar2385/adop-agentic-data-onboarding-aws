{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/v1/source.schema.json",
  "title": "Workload source config (HITL)",
  "type": "object",
  "required": ["workload", "source", "zones"],
  "additionalProperties": true,
  "properties": {
    "workload": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "format": { "type": "string" },
        "location": { "type": "string" },
        "primary_key": { "type": ["string", "array"] }
      }
    },
    "cadence": { "type": "object", "additionalProperties": true },
    "zones": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "compliance": { "type": "object", "additionalProperties": true },
    "orchestration": { "type": "object", "additionalProperties": true }
  }
}
