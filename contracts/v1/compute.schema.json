{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/v1/compute.schema.json",
  "title": "Glue compute routing spec",
  "type": "object",
  "required": ["workload", "profile", "pipeline_steps"],
  "additionalProperties": true,
  "properties": {
    "workload": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "profile": {
      "type": "object",
      "required": ["silver_format", "gold_format"],
      "properties": {
        "estimated_rows_per_run": { "type": "integer", "minimum": 0 },
        "peak_rows_per_run": { "type": "integer", "minimum": 0 },
        "silver_format": { "type": "string", "enum": ["iceberg", "parquet"] },
        "gold_format": { "type": "string", "enum": ["iceberg", "parquet"] },
        "compliance": { "type": "string" }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "properties": {
        "transform_job_type": { "type": "string", "enum": ["glueetl", "pythonshell"] },
        "quality_job_type": { "type": "string", "enum": ["glueetl", "pythonshell"] },
        "ingest_job_type": { "type": "string", "enum": ["glueetl", "pythonshell", "auto"] }
      },
      "additionalProperties": true
    },
    "pipeline_steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["job_type", "script"],
        "properties": {
          "job_type": { "type": "string", "enum": ["glueetl", "pythonshell", "auto"] },
          "script": { "type": "string", "minLength": 1 },
          "workers": { "type": "integer", "minimum": 1 },
          "worker_type": { "type": "string" },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rationale": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "terraform_sync": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "enforced"] },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "infrastructure": {
      "type": "object",
      "description": "MCP-first owners. Omit a data-plane slice to default to mcp. glue_jobs and orchestration stay terraform.",
      "additionalProperties": true,
      "properties": {
        "catalog": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["mcp", "terraform"] },
            "database": { "type": "string" }
          },
          "additionalProperties": true
        },
        "kms": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["mcp", "terraform"] },
            "zones": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "iam": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["mcp", "terraform"] }
          },
          "additionalProperties": true
        },
        "lakeformation": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["mcp", "terraform"] }
          },
          "additionalProperties": true
        },
        "glue_jobs": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["terraform"] }
          },
          "additionalProperties": true
        },
        "orchestration": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "enum": ["terraform"] }
          },
          "additionalProperties": true
        }
      }
    },
    "routing": { "type": "object" },
    "sinks": {
      "type": "object",
      "description": "Opt-in Terraform extension sinks. Default all false (catalog-only). MCP cannot create these services.",
      "additionalProperties": false,
      "properties": {
        "redshift": { "type": "boolean" },
        "opensearch": { "type": "boolean" },
        "redis": { "type": "boolean" }
      }
    }
  }
}
