{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/v1/codegen_dag.spec.schema.json",
  "title": "Codegen DAG Spec",
  "description": "Codegen wrapper for Airflow DAG rendering (extends dag_spec v1 fields).",
  "type": "object",
  "required": ["schema_version", "template_id", "dataset_name", "schedule", "tasks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "template_id": {
      "type": "string",
      "const": "airflow_dag"
    },
    "workload": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "dataset_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "dag_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,60}$"
    },
    "schedule": {
      "type": "object",
      "required": ["cron", "timezone"],
      "additionalProperties": false,
      "properties": {
        "cron": { "type": "string", "minLength": 9 },
        "timezone": { "type": "string", "minLength": 1 },
        "catchup": { "type": "boolean", "default": false },
        "max_active_runs": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
        "start_date": { "type": "string", "format": "date" }
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "delay_seconds": { "type": "integer", "minimum": 0 },
        "backoff": { "type": "boolean" },
        "max_delay_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "type"],
        "additionalProperties": false,
        "properties": {
          "task_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": {
            "type": "string",
            "enum": ["glue_job", "quality_check", "sensor", "python_callable", "dummy"]
          },
          "script_path": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "timeout_minutes": { "type": "integer", "minimum": 1 },
          "params": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "failure_handling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure_callback": {
          "type": "string",
          "enum": ["sns_alert", "slack_notify", "pagerduty", "email", "none"]
        },
        "notification_channel": { "type": "string" },
        "escalation_after_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadline_minutes": { "type": "integer", "minimum": 1 },
        "critical_tasks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
