{
  "mcpServers": {
    "agentcore-gateway": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli@latest",
        "https://adop-mcp-gateway-ztpftsljts.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp",
        "--service",
        "bedrock-agentcore",
        "--region",
        "us-east-1",
        "--profile",
        "aws-agent"
      ],
      "env": {
        "AWS_PROFILE": "aws-agent",
        "AWS_REGION": "us-east-1",
        "AWS_SDK_LOAD_CONFIG": "1"
      }
    }
  }
}
